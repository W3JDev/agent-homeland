# Agent Hub configuration — copy to .env (keep it root-only, never commit it)
PUBLIC_URL=https://hub.example.com
ENROLL_TOKEN=change-me-long-random            # comma-separate several to rotate

# Langfuse (self-hosted v3): admin login used to create projects/keys/evaluators
LANGFUSE_URL=https://langfuse.example.com
LANGFUSE_ORG=Main
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me

# LiteLLM: master key (mints per-agent keys) + a key for the LLM-as-judge connection
LITELLM_INTERNAL=http://litellm:4000
LLM_PUBLIC_URL=https://llm.example.com/v1
LITELLM_MASTER_KEY=sk-change-me
JUDGE_LLM_KEY=sk-change-me
LLM_MODEL=gpt-4o-mini
EVAL_SAMPLING=0.3
EVAL_TEMPLATES=Helpfulness,Relevance,Toxicity,Hallucination

# Optional: shared workspace handed to every agent
KB_URL=https://notes.example.com
KB_TOKEN=
PLANE_API_BASE=https://plane.example.com/api/v1
PLANE_WORKSPACE_SLUG=main
PLANE_API_TOKEN=
SOCIAL_URL=https://social.example.com
MEMOS_INTERNAL=http://memos:5230
MEMOS_ADMIN_TOKEN=
